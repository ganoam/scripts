#!/bin/bash
# Agent-generated; human reviewed.
# Run-parts multiplexer for git hooks; this file keeps the hook name
# consumers point core.hooksPath at. Executes, in order:
#   <this dir>/<hook>.d/*          shared guards shipped here
#   <repo>/git-hooks/<hook>.d/*    consumer-local gates
# where <hook> is this file's basename (pre-push, pre-commit, ...).
# Each hook gets the original args and a replayable copy of stdin
# (pre-push's pushed-ref list); the first nonzero exit aborts.
stdin_save=$(mktemp)
trap 'rm -f "$stdin_save"' EXIT
[ -t 0 ] || cat > "$stdin_save"   # skip when run by hand on a tty

self_dir="$(cd "$(dirname "$0")" && pwd)"
repo=$(git rev-parse --show-toplevel)
name=$(basename "$0")

for dir in "$self_dir/$name.d" "$repo/git-hooks/$name.d"; do
    [ -d "$dir" ] || continue
    for hook in "$dir"/*; do
        { [ -f "$hook" ] && [ -x "$hook" ]; } || continue # -f: regular files (no dirs) -x: executables
        "$hook" "$@" < "$stdin_save" || exit 1            # run with original args; < replay stdin stream
    done
done
exit 0
